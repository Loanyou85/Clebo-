# Copier ce fichier en .env.local pour le développement.
# Ne jamais commit de vraies valeurs.

# Base de données Postgres (dev ET prod) - ex: postgresql://user:pass@host:5432/clebo
# Base gratuite en 2 min : https://neon.tech ou https://vercel.com/storage/postgres
DATABASE_URL=

# Secret pour signer le cookie de session (chaîne aléatoire longue, ex: openssl rand -hex 32)
COOKIE_SIGNING_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Clé API Anthropic (optionnelle) : sans elle, la création de race par IA
# (recherche d'une race absente du catalogue dans /races) est simplement
# désactivée (le reste du site fonctionne).
# À obtenir sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# URL publique du site (utilisée pour les success_url/cancel_url Stripe ET
# les redirect_uri Google/Apple ci-dessous)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Connexion avec Google (optionnelle : sans ces deux variables, le bouton
# "Continuer avec Google" redirige simplement vers une erreur, le reste du
# site fonctionne quand même).
# 1. https://console.cloud.google.com/apis/credentials -> Créer des
#    identifiants -> ID client OAuth -> Application Web.
# 2. Origine JavaScript autorisée : NEXT_PUBLIC_SITE_URL ci-dessus.
# 3. URI de redirection autorisé : NEXT_PUBLIC_SITE_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connexion avec Apple (optionnelle, mêmes conditions que Google).
# Nécessite un compte Apple Developer payant (99$/an) :
# 1. https://developer.apple.com/account/resources/identifiers/list/serviceId
#    -> créer un "Services ID" (= APPLE_CLIENT_ID) avec "Sign in with Apple"
#    activé, domaine = celui de NEXT_PUBLIC_SITE_URL, URI de retour =
#    NEXT_PUBLIC_SITE_URL + /api/auth/apple/callback
# 2. https://developer.apple.com/account/resources/identifiers/list -> ton
#    App ID -> onglet "App IDs" pour retrouver APPLE_TEAM_ID
# 3. https://developer.apple.com/account/resources/authkeys/list -> créer une
#    clé "Sign in with Apple" -> APPLE_KEY_ID = son identifiant, et le
#    fichier .p8 téléchargé (une seule fois, à conserver précieusement) est
#    le contenu de APPLE_PRIVATE_KEY (avec des \n à la place des retours
#    à la ligne si mis sur une seule ligne dans un tableau de bord d'hébergeur)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
