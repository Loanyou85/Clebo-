# Copier ce fichier en .env.local pour le développement.
# Ne jamais commit de vraies valeurs.

# Base de données Postgres (dev ET prod) - ex: postgresql://user:pass@host:5432/clebo
# Base gratuite en 2 min : https://neon.tech ou https://vercel.com/storage/postgres
DATABASE_URL=

# Secret pour signer le cookie de session (chaîne aléatoire longue, ex: openssl rand -hex 32)
COOKIE_SIGNING_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Clé API Anthropic (optionnelle) : sans elle, la création de race par IA
# (recherche d'une race absente du catalogue dans /races) et la génération
# des exercices sur-mesure sont simplement désactivées (le reste du site
# fonctionne, les demandes d'exercices restent en attente de validation
# manuelle par un admin).
# À obtenir sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Clé API YouTube Data v3 (optionnelle) : permet d'intégrer directement une
# vraie vidéo de démonstration pertinente sous chaque exercice sur-mesure
# généré par l'IA. Sans elle, un simple lien "Rechercher sur YouTube"
# s'affiche à la place (le reste du site fonctionne).
# 1. https://console.cloud.google.com/apis/library/youtube.googleapis.com
#    -> sélectionne le même projet Google Cloud que pour Google ci-dessous
#    (ou un nouveau) -> Activer.
# 2. https://console.cloud.google.com/apis/credentials -> Créer des
#    identifiants -> Clé API (PAS un ID client OAuth, une simple "API key").
# 3. Recommandé : clique sur la clé créée -> Restrictions relatives à l'API
#    -> restreindre à "YouTube Data API v3" uniquement.
YOUTUBE_API_KEY=

# URL publique du site (utilisée pour les success_url/cancel_url Stripe ET
# le redirect_uri Google ci-dessous)
SITE_URL=http://localhost:3000

# Connexion avec Google (optionnelle : sans ces deux variables, le bouton
# "Continuer avec Google" redirige simplement vers une erreur, le reste du
# site fonctionne quand même).
# 1. https://console.cloud.google.com/apis/credentials -> Créer des
#    identifiants -> ID client OAuth -> Application Web.
# 2. Origine JavaScript autorisée : SITE_URL ci-dessus.
# 3. URI de redirection autorisé : SITE_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails (séparés par des virgules) qui ont accès à tout le site comme s'ils
# étaient abonnés, sans passer par Stripe — pratique pour un compte de
# test/démo perso. Optionnel : laisse vide pour que tout le monde passe par
# l'abonnement normal.
FREE_ACCESS_EMAILS=
