generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres : fonctionne aussi bien en développement (base gratuite type
  // Neon/Vercel Postgres) qu'en production sur un hébergeur serverless
  // (Vercel...) où le système de fichiers n'est pas persistant — un
  // fichier SQLite y serait réinitialisé à chaque déploiement.
  //
  // directUrl : les intégrations Postgres serverless (Neon via Vercel)
  // fournissent une connexion "poolée" (via PgBouncer) pour les requêtes
  // de l'application, mais les changements de schéma (`prisma db push` /
  // `migrate`) ont besoin d'une connexion directe — sans quoi ils peuvent
  // échouer silencieusement ou par des erreurs peu explicites à cause du
  // mode transaction du pooler. Voir scripts/prepare-database-url.mjs.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum DogSize {
  PETIT
  MOYEN
  GRAND
}

enum Environment {
  CAMPAGNE
  VILLE
  APPARTEMENT
  MAISON
}

enum ExerciseLevel {
  PROPRETE
  RAPPEL
  LAISSE
  OBEISSANCE_BASE
  SOCIALISATION
}

enum RequestStatus {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  CANCELED
  PAST_DUE
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  passwordHash         String
  isAdmin              Boolean             @default(false)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  subscriptionStatus   SubscriptionStatus  @default(INACTIVE)
  createdAt            DateTime            @default(now())
  dogs                 Dog[]
  exerciseRequests     ExerciseRequest[]
}

model Breed {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  imageUrl     String
  description  String
  temperament  String
  weightMinKg  Float
  weightMaxKg Float
  createdAt    DateTime         @default(now())
  dogs         Dog[]
  exercises    ExerciseBreed[]
  foodBrands   FoodBrandBreed[]
}

model Dog {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  breedId          String?
  breed            Breed?            @relation(fields: [breedId], references: [id])
  isMixed          Boolean           @default(false)
  mixedBreedNote   String?
  characteristics  String?
  size             DogSize
  weightKg         Float
  ageMonths        Int
  environment      Environment
  createdAt        DateTime          @default(now())
  exerciseRequests ExerciseRequest[]

  // Analyse IA du mélange de races déclaré par le client (mixedBreedNote) :
  // races connues du site les plus proches détectées par l'IA (pour
  // réutiliser les exercices/marques déjà associés à ces races) + un
  // résumé personnalisé du programme de dressage. Regénérée uniquement
  // quand mixedBreedNote change (voir lib/mixedBreedAnalysis.ts).
  aiMatchedBreedSlugs String[] @default([])
  aiTrainingSummary   String?
  aiAnalyzedNote      String?
}

model Exercise {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  level           ExerciseLevel
  description     String
  imageUrl        String?
  videoUrl        String?
  repetitions     Int
  frequencyPerDay Int
  durationWeeks   Int
  forAllBreeds    Boolean         @default(false)
  createdAt       DateTime        @default(now())
  breeds          ExerciseBreed[]
}

model ExerciseBreed {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  breedId    String
  breed      Breed    @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, breedId])
}

model FoodBrand {
  id           String           @id @default(cuid())
  name         String
  imageUrl     String?
  description  String
  forAllBreeds Boolean          @default(false)
  breeds       FoodBrandBreed[]
}

model FoodBrandBreed {
  id          String    @id @default(cuid())
  foodBrandId String
  foodBrand   FoodBrand @relation(fields: [foodBrandId], references: [id], onDelete: Cascade)
  breedId     String
  breed       Breed     @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@unique([foodBrandId, breedId])
}

model ExerciseRequest {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dogId       String?
  dog         Dog?           @relation(fields: [dogId], references: [id])
  title       String
  description String
  status      RequestStatus  @default(EN_ATTENTE)
  adminNote   String?
  createdAt   DateTime       @default(now())
  reviewedAt  DateTime?
}
